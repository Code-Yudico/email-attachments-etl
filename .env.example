# Copy this file to .env and adjust the values. Never commit .env.

# --- Mailbox (IMAP) --------------------------------------------------------
# Matches the test mail server in docker-compose.yml.
IMAP_HOST=localhost
IMAP_PORT=3143
IMAP_USER=etl@example.test
IMAP_PASSWORD=any-password-works-on-the-test-server
IMAP_FOLDER=INBOX
# Use IMAP4 over SSL. The test server runs plaintext on 3143; a real mailbox
# should always set this to yes (and usually port 993).
IMAP_USE_SSL=no

# Used only by scripts/seed_mailbox.py to deliver the synthetic reports.
SMTP_HOST=localhost
SMTP_PORT=3025

# --- SQL Server ------------------------------------------------------------
DB_SERVER=localhost,1433
DB_DATABASE=email_etl_demo
DB_USER=sa
DB_PASSWORD=Local_Dev_Pass123
DB_DRIVER=ODBC Driver 18 for SQL Server
# Driver 18 encrypts by default and the local container uses a self-signed
# certificate. Local development only.
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Pipeline --------------------------------------------------------------
# Where attachments are written before being read.
WORK_DIR=data/attachments
# How far back to look the first time a subject is seen.
INITIAL_LOOKBACK_DAYS=30
